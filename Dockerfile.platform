FROM node:24-alpine AS web
WORKDIR /build/web
COPY web/package*.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build

FROM golang:1.27.3-alpine AS go
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /platform ./cmd/kubepilot-platform && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /connector ./cmd/kubepilot-connector

FROM alpine:3.22 AS base
RUN apk add --no-cache ca-certificates && \
    addgroup -g 10001 agent && adduser -D -u 10001 -G agent agent && \
    mkdir -p /app/data /data && chown -R agent:agent /app /data
WORKDIR /app
USER 10001:10001

FROM base AS connector
COPY --from=go /connector /app/connector
ENTRYPOINT ["/app/connector"]

FROM base AS platform
COPY --from=go /platform /app/platform
COPY --from=web /build/web/dist /app/web/dist
ENV PLATFORM_ADDR=0.0.0.0:18081 PLATFORM_DATA_DIR=/app/data PLATFORM_WEB_DIR=/app/web/dist
EXPOSE 18081
ENTRYPOINT ["/app/platform"]
