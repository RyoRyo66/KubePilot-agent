# Copy to .env.platform. This example is for local development only.
# docker compose --env-file .env.platform -f compose.platform.yaml up -d --build
# For network use, set https://your-platform.example and place behind a TLS proxy.
# The proxy must preserve the public Host header; forwarded headers are not trusted.
PLATFORM_PUBLIC_ORIGIN=http://127.0.0.1:18081
PLATFORM_ALLOW_HTTP=true
# Set true after registering the intended accounts to close public registration.
PLATFORM_REGISTRATION_CLOSED=false
# Loopback preview by default; choose a reachable LAN IP only for an intended lab.
PLATFORM_BIND=127.0.0.1
