{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "kubepilot-monitoring"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "prometheus",
        "namespace": "kubepilot-monitoring",
        "labels": {
          "app.kubernetes.io/part-of": "kubepilot-lab"
        }
      },
      "data": {
        "prometheus.yml": "global:\n  scrape_interval: 5s\n  evaluation_interval: 5s\n  scrape_timeout: 4s\n  external_labels:\n    cluster: kubepilot-lab\nrule_files:\n  - /etc/prometheus/alerts.yml\nalerting:\n  alertmanagers:\n    - static_configs:\n        - targets: [alertmanager:9093]\nscrape_configs:\n  - job_name: prometheus\n    static_configs:\n      - targets: [localhost:9090]\n  - job_name: alertmanager\n    static_configs:\n      - targets: [alertmanager:9093]\n  - job_name: demo-web-http\n    metrics_path: /probe\n    params:\n      module: [http_2xx]\n    static_configs:\n      - targets: [http://demo-web.kube-agent-lab.svc.cluster.local/]\n        labels:\n          namespace: kube-agent-lab\n          service: demo-web\n    relabel_configs:\n      - source_labels: [__address__]\n        target_label: __param_target\n      - source_labels: [__param_target]\n        target_label: instance\n      - target_label: __address__\n        replacement: blackbox-exporter:9115\n",
        "alerts.yml": "groups:\n  - name: kubepilot-demo\n    rules:\n      - alert: KubePilotDemoWebUnavailable\n        expr: probe_success{job=\"demo-web-http\",namespace=\"kube-agent-lab\",service=\"demo-web\"} == 0\n        for: 5s\n        labels:\n          severity: warning\n        annotations:\n          summary: \"demo-web HTTP probe failed\"\n          description: \"Blackbox Exporter cannot reach the demo-web Service. Collect live Kubernetes evidence before deciding whether a repair is safe.\"\n"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "alertmanager",
        "namespace": "kubepilot-monitoring",
        "labels": {
          "app.kubernetes.io/part-of": "kubepilot-lab"
        }
      },
      "data": {
        "alertmanager.yml": "global:\n  resolve_timeout: 1m\nroute:\n  receiver: kubepilot\n  group_by: [alertname, namespace, service]\n  group_wait: 1s\n  group_interval: 5s\n  repeat_interval: 5m\nreceivers:\n  - name: kubepilot\n    webhook_configs:\n      - url: http://platform-gateway:8080/ingest/alertmanager\n        send_resolved: true\n        max_alerts: 10\n        http_config:\n          authorization:\n            type: Bearer\n            credentials_file: /etc/kubepilot-token/webhook-token\n"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "blackbox-exporter",
        "namespace": "kubepilot-monitoring",
        "labels": {
          "app.kubernetes.io/part-of": "kubepilot-lab"
        }
      },
      "data": {
        "blackbox.yml": "modules:\n  http_2xx:\n    prober: http\n    timeout: 2s\n    http:\n      method: GET\n      preferred_ip_protocol: ip4\n      valid_status_codes: [200]\n      fail_if_body_not_matches_regexp: [\"Welcome to nginx\"]\n"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "platform-gateway",
        "namespace": "kubepilot-monitoring",
        "labels": {
          "app.kubernetes.io/part-of": "kubepilot-lab"
        }
      },
      "data": {
        "gateway.conf": "worker_processes 1;\npid /tmp/nginx.pid;\nevents { worker_connections 128; }\nhttp {\n  access_log /dev/stdout;\n  error_log /dev/stderr warn;\n  client_body_temp_path /tmp/client;\n  proxy_temp_path /tmp/proxy;\n  fastcgi_temp_path /tmp/fastcgi;\n  uwsgi_temp_path /tmp/uwsgi;\n  scgi_temp_path /tmp/scgi;\n  server {\n    listen 8080;\n    client_max_body_size 2m;\n    location = /healthz { access_log off; return 200 \"ok\\n\"; }\n    # Only authenticated machine endpoints are reachable through this gateway.\n    # The Windows UI remains on its existing loopback origin.\n    location ~ ^/(ingest/alertmanager|connector/poll|connector/result)$ {\n      limit_except POST { deny all; }\n      proxy_pass http://host.docker.internal:18081;\n      proxy_set_header Host 127.0.0.1:18081;\n      proxy_set_header Connection \"\";\n      proxy_http_version 1.1;\n      proxy_read_timeout 60s;\n    }\n    location / { return 404; }\n  }\n}\n"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "prometheus-data",
        "namespace": "kubepilot-monitoring",
        "labels": {
          "app.kubernetes.io/part-of": "kubepilot-lab"
        }
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "storageClassName": "standard",
        "resources": {
          "requests": {
            "storage": "2Gi"
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "alertmanager-data",
        "namespace": "kubepilot-monitoring",
        "labels": {
          "app.kubernetes.io/part-of": "kubepilot-lab"
        }
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "storageClassName": "standard",
        "resources": {
          "requests": {
            "storage": "1Gi"
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "prometheus",
        "namespace": "kubepilot-monitoring",
        "labels": {
          "app.kubernetes.io/part-of": "kubepilot-lab"
        }
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "prometheus"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "prometheus"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 65534,
              "runAsGroup": 65534,
              "fsGroup": 65534
            },
            "containers": [
              {
                "name": "prometheus",
                "image": "prom/prometheus:v3.13.5",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 9090
                  }
                ],
                "args": [
                  "--config.file=/etc/prometheus/prometheus.yml",
                  "--storage.tsdb.path=/prometheus",
                  "--storage.tsdb.retention.time=24h",
                  "--storage.tsdb.retention.size=256MB",
                  "--web.enable-lifecycle"
                ],
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/etc/prometheus",
                    "readOnly": true
                  },
                  {
                    "name": "data",
                    "mountPath": "/prometheus",
                    "readOnly": false
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "10m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "512Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/-/ready",
                    "port": 9090
                  },
                  "initialDelaySeconds": 2,
                  "periodSeconds": 3
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/-/ready",
                    "port": 9090
                  },
                  "initialDelaySeconds": 30,
                  "periodSeconds": 10
                }
              }
            ],
            "volumes": [
              {
                "name": "config",
                "configMap": {
                  "name": "prometheus"
                }
              },
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "prometheus-data"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "prometheus",
        "namespace": "kubepilot-monitoring",
        "labels": {
          "app.kubernetes.io/part-of": "kubepilot-lab"
        }
      },
      "spec": {
        "selector": {
          "app": "prometheus"
        },
        "ports": [
          {
            "name": "http",
            "port": 9090,
            "targetPort": 9090
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "alertmanager",
        "namespace": "kubepilot-monitoring",
        "labels": {
          "app.kubernetes.io/part-of": "kubepilot-lab"
        }
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "alertmanager"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "alertmanager"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 65534,
              "runAsGroup": 65534,
              "fsGroup": 65534
            },
            "containers": [
              {
                "name": "alertmanager",
                "image": "prom/alertmanager:v0.35.0",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 9093
                  }
                ],
                "args": [
                  "--config.file=/etc/alertmanager/alertmanager.yml",
                  "--storage.path=/alertmanager",
                  "--cluster.listen-address="
                ],
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/etc/alertmanager",
                    "readOnly": true
                  },
                  {
                    "name": "data",
                    "mountPath": "/alertmanager",
                    "readOnly": false
                  },
                  {
                    "name": "token",
                    "mountPath": "/etc/kubepilot-token",
                    "readOnly": true
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "10m",
                    "memory": "32Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "128Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/-/ready",
                    "port": 9093
                  },
                  "initialDelaySeconds": 2,
                  "periodSeconds": 3
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/-/ready",
                    "port": 9093
                  },
                  "initialDelaySeconds": 30,
                  "periodSeconds": 10
                }
              }
            ],
            "volumes": [
              {
                "name": "config",
                "configMap": {
                  "name": "alertmanager"
                }
              },
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "alertmanager-data"
                }
              },
              {
                "name": "token",
                "secret": {
                  "secretName": "kubepilot-alertmanager",
                  "defaultMode": 288
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "alertmanager",
        "namespace": "kubepilot-monitoring",
        "labels": {
          "app.kubernetes.io/part-of": "kubepilot-lab"
        }
      },
      "spec": {
        "selector": {
          "app": "alertmanager"
        },
        "ports": [
          {
            "name": "http",
            "port": 9093,
            "targetPort": 9093
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "blackbox-exporter",
        "namespace": "kubepilot-monitoring",
        "labels": {
          "app.kubernetes.io/part-of": "kubepilot-lab"
        }
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "blackbox-exporter"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "blackbox-exporter"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 65534,
              "runAsGroup": 65534,
              "fsGroup": 65534
            },
            "containers": [
              {
                "name": "blackbox-exporter",
                "image": "prom/blackbox-exporter:v0.29.1",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 9115
                  }
                ],
                "args": [
                  "--config.file=/etc/blackbox/blackbox.yml"
                ],
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/etc/blackbox",
                    "readOnly": true
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "10m",
                    "memory": "16Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "64Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/metrics",
                    "port": 9115
                  },
                  "initialDelaySeconds": 2,
                  "periodSeconds": 3
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/metrics",
                    "port": 9115
                  },
                  "initialDelaySeconds": 30,
                  "periodSeconds": 10
                }
              }
            ],
            "volumes": [
              {
                "name": "config",
                "configMap": {
                  "name": "blackbox-exporter"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "blackbox-exporter",
        "namespace": "kubepilot-monitoring",
        "labels": {
          "app.kubernetes.io/part-of": "kubepilot-lab"
        }
      },
      "spec": {
        "selector": {
          "app": "blackbox-exporter"
        },
        "ports": [
          {
            "name": "http",
            "port": 9115,
            "targetPort": 9115
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "platform-gateway",
        "namespace": "kubepilot-monitoring",
        "labels": {
          "app.kubernetes.io/part-of": "kubepilot-lab"
        }
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "platform-gateway"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "platform-gateway"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 101,
              "runAsGroup": 101,
              "fsGroup": 101
            },
            "containers": [
              {
                "name": "platform-gateway",
                "image": "nginx:1.28-alpine",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080
                  }
                ],
                "args": [
                  "-c",
                  "/etc/lab/gateway.conf",
                  "-g",
                  "daemon off;"
                ],
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/etc/lab",
                    "readOnly": true
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp",
                    "readOnly": false
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "10m",
                    "memory": "16Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "64Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": 8080
                  },
                  "initialDelaySeconds": 2,
                  "periodSeconds": 3
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": 8080
                  },
                  "initialDelaySeconds": 30,
                  "periodSeconds": 10
                },
                "command": [
                  "nginx"
                ]
              }
            ],
            "volumes": [
              {
                "name": "config",
                "configMap": {
                  "name": "platform-gateway"
                }
              },
              {
                "name": "tmp",
                "emptyDir": {}
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "platform-gateway",
        "namespace": "kubepilot-monitoring",
        "labels": {
          "app.kubernetes.io/part-of": "kubepilot-lab"
        }
      },
      "spec": {
        "selector": {
          "app": "platform-gateway"
        },
        "ports": [
          {
            "name": "http",
            "port": 8080,
            "targetPort": 8080
          }
        ]
      }
    }
  ]
}
